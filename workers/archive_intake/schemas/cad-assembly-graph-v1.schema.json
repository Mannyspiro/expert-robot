{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merlin.local/schemas/cad-assembly-graph-v1.schema.json",
  "title": "Merlin CAD Assembly Frame Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assembly_version", "assembly_id", "units", "components"],
  "properties": {
    "assembly_version": {"const": "1.0"},
    "assembly_id": {"type": "string", "minLength": 1},
    "units": {
      "type": "object",
      "required": ["length", "angle"],
      "properties": {
        "length": {"type": "string", "minLength": 1},
        "angle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "parent_component_id", "artifact_sha256", "parent_from_component"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "parent_component_id": {"type": ["string", "null"]},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parent_from_component": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number"}
            }
          },
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
