{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin Avrea Approval Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "task_contract_sha256",
    "approved_by",
    "approval_source",
    "approved_at",
    "status"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approval_source": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_note": {
      "type": "string"
    },
    "status": {
      "const": "approved"
    }
  }
}
