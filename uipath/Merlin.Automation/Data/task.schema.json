{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merlin.local/schemas/task.schema.json",
  "title": "Merlin Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "operation",
    "repository",
    "source",
    "budget",
    "approval",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "type": "string",
      "enum": [
        "archive.intake",
        "github.read_repository",
        "github.read_pull_request",
        "github.prepare_draft_pr",
        "avrea.dispatch_allowlisted_workflow",
        "avrea.collect_artifacts",
        "cace.run_lean_qualification",
        "research.register_public_source",
        "engineering.capture_artifact"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "connection_alias"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "connection_alias": {
          "type": "string",
          "enum": [
            "Primary",
            "MorgansCace"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "expected_head_sha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "timeout_seconds",
        "max_artifact_mb"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_artifact_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "action"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "none",
            "open_draft_pr",
            "external_write",
            "engineering_promotion"
          ]
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
