{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merlin.local/schema/cdam/usr.schema.json",
  "title": "Universal System Representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_id", "domain", "nodes", "edges", "invariant_ids", "assumptions", "validity_regime", "unit_status"],
  "properties": {
    "system_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "kind", "dimension"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["variable", "component", "operator", "constraint", "boundary", "storage"]},
          "dimension": {
            "type": "array", "minItems": 7, "maxItems": 7,
            "items": {"type": "integer", "minimum": -16, "maximum": 16},
            "description": "SI base exponents in order kg, m, s, A, K, mol, cd"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "relation", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "validity_regime": {"type": "string"},
    "unit_status": {"enum": ["unchecked", "consistent", "inconsistent"]}
  }
}