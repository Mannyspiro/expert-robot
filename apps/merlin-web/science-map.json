  "historical_programs": [
    {
      "id": "alchemy",
      "label": "Alchemy",
      "status": "historical",
      "lesson": "Preserved experimental practices and material knowledge while its theoretical framework was transformed by modern chemistry."
    },
    {
      "id": "phlogiston",
      "label": "Phlogiston theory",
      "status": "obsolete_or_superseded",
      "lesson": "A useful case for studying how measurement, mass balance and new explanatory frameworks displaced a dominant theory."
    },
    {
      "id": "caloric",
      "label": "Caloric theory",
      "status": "obsolete_or_superseded",
      "lesson": "Shows how heat moved from a material-fluid picture toward energy and statistical mechanics."
    },
    {
      "id": "vitalism",
      "label": "Vitalism",
      "status": "historical",
      "lesson": "Useful for tracing disputes about mechanism, emergence and biological explanation; not a current substitute for biochemical accounts."
    },
    {
      "id": "ether",
      "label": "Luminiferous ether",
      "status": "obsolete_or_superseded",
      "lesson": "Shows how a background medium was motivated, tested and abandoned as relativity and experiment changed the problem."
    },
    {
      "id": "phrenology",
      "label": "Phrenology",
      "status": "obsolete_or_superseded",
      "lesson": "A cautionary example of weak measurement, confirmation bias and social prejudice dressed as scientific certainty."
    },
    {
      "id": "humoral",
      "label": "Humoral medicine",
      "status": "historical",
      "lesson": "Study as a historical explanatory system, not as a modern clinical guide."
    },
    {
      "id": "miasma",
      "label": "Miasma theory",
      "status": "obsolete_or_superseded",
      "lesson": "Contrasts environmental observation with later microbial causal evidence."
    }
  ],
