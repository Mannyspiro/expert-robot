# Conservative portal/anomaly research template.
# This does not claim a portal exists. It tests whether a structured boundary
# configuration produces any reproducible P2-level field/energy residual after
# ordinary acoustic/EM/thermal/optical explanations are bounded.

RITUAL 0.1
ID portal-p2-boundary-null-template
TITLE "Portal P2 boundary/field anomaly null experiment"
TRADITION "Modern reconstruction inspired by historical circle protocols"

WITNESS reconstruction-001 kind=reconstruction provenance=derivative weight=0.2 notes="Synthetic test program informed by historical protocol structure, not a historical witness."

CLAIM P2_field_energy historical_only "A structured circular boundary, symbolic layout, material placement, and low-energy excitation are tested for reproducible field residuals beyond declared ordinary models."
PREDICT "Under the null model, all sensor changes are explained by acoustic, electromagnetic, thermal, optical, vibration, and instrument-noise channels."

PARAM radius kind=continuous role=geometry min=0.5 max=2 units=m provenance=reconstruction-001
PARAM orientation kind=continuous role=orientation min=0 max=360 units=deg provenance=reconstruction-001
PARAM excitation-mode kind=categorical role=acoustic values=silence,live_voice,recorded_control provenance=reconstruction-001

CIRCLE outer radius=1 center=0,0,0 normal=0,0,1
CIRCLE inner radius=3/4 center=0,0,0 normal=0,0,1
POINT detector-center xyz=0,0,0
TOPOLOGY "inner contained_by outer"
ORIENTATION_SENSITIVE true

SYMBOL marker-a kind=glyph role=coordinate text="<A>" position="outer@0deg" order=0 repeat=1 confidence=1 provenance=reconstruction-001
SYMBOL marker-b kind=glyph role=coordinate text="<B>" position="outer@90deg" order=1 repeat=1 confidence=1 provenance=reconstruction-001
SYMBOL marker-c kind=glyph role=coordinate text="<C>" position="outer@180deg" order=2 repeat=1 confidence=1 provenance=reconstruction-001
SYMBOL marker-d kind=glyph role=coordinate text="<D>" position="outer@270deg" order=3 repeat=1 confidence=1 provenance=reconstruction-001

VOICE marker-a mode=live_voice spl=65 repeat=1
ENERGY low-acoustic kind=acoustic role="low-energy measured acoustic excitation" measured=true
PROCESS excite-boundary kind=expose targets=outer energy=low-acoustic order=0 simulation_only=false
PROCESS observe-center kind=observe targets=detector-center order=1 simulation_only=false

ORIENT laboratory azimuth=0 inclination=0

STEP "calibrate all sensors before condition reveal"
STEP "apply randomized geometry/orientation/excitation condition"
STEP "record synchronized sensor channels"
STEP "compare measurements to preregistered known-physics bounds"

MEASURE magnetic instrument="3-axis magnetometer" rate=2000 uncertainty="calibration plus baseline drift"
MEASURE electric instrument="electric-field probe" rate=2000 uncertainty="calibration plus environmental baseline"
MEASURE rf instrument="broadband RF monitor" rate=2000 uncertainty="instrument and ambient RF model"
MEASURE acoustic instrument="calibrated microphone" rate=96000 uncertainty="room impulse response and calibration"
MEASURE vibration instrument="3-axis accelerometer" rate=5000 uncertainty="support transfer function"
MEASURE thermal instrument="temperature sensor" rate=10 uncertainty="sensor drift"
MEASURE optical instrument="fixed calibrated camera" rate=60 uncertainty="illumination and sensor noise"

CONTROL "remove all symbols while preserving physical geometry"
CONTROL "scramble symbol positions"
CONTROL "rotate full apparatus"
CONTROL "replace live voice with calibrated playback"
CONTROL "silence"
CONTROL "empty-room sensor baseline"
CONTROL "sensor substitution"
CONTROL "shielded condition where compatible with measured channel"

BLINDING automated
RANDOMIZE true
PREREGISTER true
HOLDOUT 0.25

MODEL acoustic_wave
MODEL maxwell_em
MODEL heat
MODEL elastic_vibration
MODEL optics
MODEL sensor_noise

UNKNOWN p2-residual policy=residual_only "Multi-sensor residual beyond certified declared-model uncertainty; does not identify a mechanism"
END
