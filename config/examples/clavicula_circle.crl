# Clavicula / Key-of-Solomon style topology research template.

RITUAL 0.1
ID clavicula-circle-opening-template
TITLE "Clavicula boundary-opening topology experiment"
TRADITION "Clavicula / Key of Solomon"

WITNESS clav-text kind=critical_edition provenance=direct weight=0.85 notes="Protocol-level template; individual manuscript diagrams must receive their own witness records."

CLAIM P0_perceptual historical_only "Nested ritual boundaries, directional regions, an intentional entry/egress opening, and placed symbols/implements are claimed to define a protected operational space."
LOCUS boundary-opening feature=topology channel=textual witnesses=clav-text state=intentional_entry_egress_opening confidence=0.9 group=clav-opening status=observed target=geometry.east-opening
LOCUS cardinal-regions feature=orientation channel=textual witnesses=clav-text state=four_directional_regions confidence=0.9 group=clav-cardinals status=observed target=orientation
PREDICT "Any physical effect attributable to the opening should scale with ordinary acoustic, airflow, optical, thermal, or field boundary changes."

CIRCLE outer radius=2 center=0,0,0 normal=0,0,1
CIRCLE middle radius=7/4 center=0,0,0 normal=0,0,1
CIRCLE inner radius=3/2 center=0,0,0 normal=0,0,1
POINT east-opening xyz=2,0,0
TOPOLOGY "inner contained_by middle"
TOPOLOGY "middle contained_by outer"
TOPOLOGY "east-opening marks intentional outer-boundary break"
ORIENTATION_SENSITIVE true

SYMBOL east-label kind=diagram_label role=coordinate text="<EAST_REGION_LABEL>" position="outer@0deg" order=0 repeat=1 confidence=0.8 provenance=clav-text
SYMBOL south-label kind=diagram_label role=coordinate text="<SOUTH_REGION_LABEL>" position="outer@90deg" order=1 repeat=1 confidence=0.8 provenance=clav-text
SYMBOL west-label kind=diagram_label role=coordinate text="<WEST_REGION_LABEL>" position="outer@180deg" order=2 repeat=1 confidence=0.8 provenance=clav-text
SYMBOL north-label kind=diagram_label role=coordinate text="<NORTH_REGION_LABEL>" position="outer@270deg" order=3 repeat=1 confidence=0.8 provenance=clav-text

ORIENT manuscript_relative azimuth=0

STEP "construct nested boundaries"
STEP "establish controlled boundary opening"
STEP "place directional symbolic slots"
STEP "run randomized open/closed/sham-opening conditions"

MEASURE acoustic instrument="microphone array" rate=96000 uncertainty="calibration and room impulse response"
MEASURE pressure instrument="differential pressure sensor" rate=1000 uncertainty="instrument calibration"
MEASURE thermal instrument="thermal camera" rate=30 uncertainty="camera calibration"
MEASURE electric instrument="electric-field probe" rate=1000 uncertainty="instrument calibration"
MEASURE optical instrument="fixed camera" rate=60 uncertainty="sensor and illumination drift"

CONTROL "close the opening with visually matched boundary material"
CONTROL "move opening to randomized azimuth"
CONTROL "draw sham opening without changing physical boundary"
CONTROL "rotate symbols independently of opening"
CONTROL "remove human observer"

BLINDING double
RANDOMIZE true
PREREGISTER true
HOLDOUT 0.2

MODEL acoustic_wave
MODEL heat
MODEL maxwell_em
MODEL optics
MODEL sensor_noise

UNKNOWN unmodeled-residual policy=residual_only "Residual surviving boundary-condition models and holdout"
END
