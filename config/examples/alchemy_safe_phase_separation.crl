# Simulation-first alchemical process template.
# This example represents process structure, not a claim that historical
# terminology maps one-to-one onto modern chemistry.

RITUAL 0.1
ID alchemy-safe-phase-separation-template
TITLE "Alchemy-inspired dissolution and crystallization research template"
TRADITION "Historical alchemical process family"

WITNESS process-template kind=reconstruction provenance=derivative weight=0.4 notes="Generic process-class template derived from historical alchemical operation types; not a diplomatic witness transcription."

CLAIM P0_perceptual historical_only "Historical alchemical procedures often attribute special significance to ordered material transformations; this template tests whether measurable outcomes are fully explained by ordinary chemistry, heat transfer, phase behavior, and process sequence."
PREDICT "Final phase composition and crystal morphology should be explained by material identity, concentration, temperature history, impurities, geometry, and process order."

PARAM material-class kind=categorical role=material values=safe_salt_A,safe_salt_B provenance=process-template
PARAM process-order kind=categorical role=process values=standard,reversed provenance=process-template
PARAM cooling-profile kind=categorical role=process values=slow,fast provenance=process-template

MATERIAL solvent class="aqueous solvent" role="carrier medium"
MATERIAL solute class="safe inorganic salt model" role="dissolved/crystallizing species"

ENERGY thermal-stage kind=thermal role="controlled heating/cooling profile" measured=true

PROCESS dissolve-step kind=dissolve targets=solute,solvent order=0 simulation_only=true
PROCESS heat-step kind=heat targets=solute,solvent energy=thermal-stage order=1 simulation_only=true
PROCESS filter-step kind=filter targets=solute,solvent order=2 simulation_only=true
PROCESS cool-step kind=cool targets=solute,solvent energy=thermal-stage order=3 simulation_only=true
PROCESS observe-step kind=observe targets=solute order=4 simulation_only=true

POINT vessel-center xyz=0,0,0

STEP "bind declared safe material model"
STEP "apply declared process order"
STEP "record temperature and optical evolution"
STEP "compare final phase state with known chemistry/phase model"

MEASURE thermal instrument="calibrated temperature sensor" rate=10 uncertainty="sensor calibration"
MEASURE optical instrument="fixed camera or microscope" rate=5 uncertainty="illumination and sensor drift"
MEASURE chemical instrument="validated composition assay" rate=1 uncertainty="assay uncertainty"

CONTROL "reverse the declared process order"
CONTROL "hold thermal history constant while changing material class"
CONTROL "hold material class constant while changing cooling profile"
CONTROL "run blank solvent control"

BLINDING automated
RANDOMIZE true
PREREGISTER true
HOLDOUT 0.2

MODEL heat
MODEL fluid
MODEL chemical
MODEL optics
MODEL sensor_noise

UNKNOWN unmodeled-residual policy=residual_only "Residual composition/morphology outside declared physical/chemical model and uncertainty"
END
