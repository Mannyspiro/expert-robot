{
  "schema_version": 1,
  "sink": "Base44.RunTelemetry",
  "authoritative": false,
  "required_fields": [
    "repository",
    "branch",
    "commit_sha",
    "run_id",
    "kind",
    "lane",
    "status",
    "authoritative"
  ],
  "optional_fields": [
    "run_url",
    "summary"
  ],
  "allowed_kinds": [
    "ci",
    "benchmark",
    "formal",
    "cace_bridge",
    "railway_preflight"
  ],
  "authority_rule": "Telemetry may summarize evidence but can never qualify, promote, or replace canonical GitHub/Lean/SQLite evidence.",
  "data_policy": {
    "forbidden": [
      "credentials",
      "private keys",
      "repository secrets",
      "model weights",
      "canonical proof objects",
      "proof-memory databases"
    ]
  }
}
