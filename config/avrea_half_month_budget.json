    {
      "id": "second_half",
      "start_day": 16,
      "end_day": "last",
      "budget_minutes": 1500
    }
  ],
  "non_transferable": true,
  "monthly_max_minutes": 3000,
  "fail_closed_on_usage_error": true,
  "reserve_full_job_timeout": true,
  "minute_basis": "Avrea free-tier 2-vCPU-equivalent minutes (8 vCPU = 4x; 32 vCPU = 16x)",
