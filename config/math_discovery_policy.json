{
  "schema_version": 1,
  "objective": "convert experimentally suggested mathematical structure into formally verified and empirically useful CACE optimizations without expanding authority",
  "candidate_selection": {
    "minimum_fit_score": 0.995,
    "maximum_observed_counterexamples": 0,
    "minimum_samples": 4,
    "require_source_artifact_hash": true,
    "require_holdout_sealed_before_proof_search": true
  },
  "counterexample_gate": {
    "required": true,
    "strategies": [
      "boundary_cases",
      "degenerate_cases",
      "random_exact_examples",
      "symmetry_breaking_examples",
      "alternate_coordinate_frames",
      "theorem_graph_contradiction_search"
    ],
    "counterexample_means": "candidate_refuted_or_assumptions_revised"
  },
  "formal_gate": {
    "required": true,
    "formalizer": "ModelFormalizationProposer",
    "proof_engine": "RecursiveLemmaFactory",
    "authority": "Lean",
    "theorem_registry_required": true,
    "axiom_audit_required": true
  },
  "optimization_gate": {
    "required": true,
    "proof_is_not_sufficient_for_activation": true,
    "implementation_equivalence_required": true,
    "benchmark_required": true,
    "ablation_required": true,
    "blind_holdout_non_regression_required": true,
    "rollback_required": true,
    "minimum_speedup": 1.02,
    "maximum_memory_ratio_without_explicit_tradeoff": 1.05
  },
  "runtime_promotion": {
    "automatic_after_all_gates": true,
    "authority_delta": 0,
    "collar_required": true,
    "core_integrity_required": true,
    "lineage_required": true,
    "retire_if_later_regression": true
  },
  "retention": {
    "refuted_candidates_are_kept": true,
    "proved_theorems_survive_optimization_retirement": true,
    "negative_benchmarks_are_kept": true,
    "failed_optimization_attempts_inform_future_search": true
  }
}
