{
  "schema": "expert_robot.sandbox-policy.v1",
  "provenance": {
    "source_repository": "Mannyspiro/refactored-fishstick",
    "source_commit": "77224183e78a262a34b2c1c311b1d1fbc7c59b4e",
    "source_path": "sandbox/base-policy.json"
  },
  "network": false,
  "runtime_mapping": "expert_robot_runtime",
  "runtime_mount": "/var/lib/expert-robot/runtime",
  "agent_root_read_only": true,
  "writable_paths": [
    "/var/lib/expert-robot/runtime/work",
    "/var/lib/expert-robot/runtime/candidates"
  ],
  "forbidden_paths": [
    "/etc/expert-robot",
    "/usr/libexec/expert-robot",
    "/boot",
    "/home",
    "/root"
  ],
  "forbidden_capabilities": [
    "authorityWrite",
    "hostWrite",
    "network"
  ],
  "allow_privilege_escalation": false,
  "owner_private_key_mount": false
}
