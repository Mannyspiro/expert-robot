{
  "schema_version": 1,
  "policy_name": "matter_production_readiness",
  "principle": "Computational structures are never a release authorization; independent chemistry, physics, safety, reproducibility and manufacturing evidence are required.",
  "stages": [
    {
      "id": "computational_structure",
      "required_evidence": [
        "valid_structure",
        "3d_structure",
        "provenance"
      ],
      "description": "Machine-readable structure + computational geometry. This alone makes no stability or synthesis claim."
    },
    {
      "id": "qualified_model",
      "required_evidence": [
        "valid_structure",
        "3d_structure",
        "provenance",
        "independent_theory_validation",
        "thermodynamic_stability",
        "properties_uncertainty",
        "cross_model_agreement"
      ],
      "description": "Applicable validated predictions with uncertainty. Still not physical proof."
    },
    {
      "id": "lab_verified_sample",
      "required_evidence": [
        "valid_structure",
        "3d_structure",
        "provenance",
        "independent_theory_validation",
        "thermodynamic_stability",
        "properties_uncertainty",
        "cross_model_agreement",
        "lab_sample_characterized",
        "safety_review",
        "independent_replication",
        "identity_and_purity_assay"
      ],
      "description": "Physical sample characterized and independently replicated under safety review."
    },
    {
      "id": "production_grade",
      "required_evidence": [
        "valid_structure",
        "3d_structure",
        "provenance",
        "independent_theory_validation",
        "thermodynamic_stability",
        "properties_uncertainty",
        "cross_model_agreement",
        "lab_sample_characterized",
        "safety_review",
        "independent_replication",
        "identity_and_purity_assay",
        "process_capability",
        "batch_traceability",
        "quality_acceptance_criteria",
        "regulatory_and_ip_review"
      ],
      "description": "Validated reproducible process, traceability, release criteria and relevant compliance. Requires external independent manufacturing evidence."
    }
  ],
  "external_required": [
    "lab_sample_characterized",
    "safety_review",
    "independent_replication",
    "identity_and_purity_assay",
    "process_capability",
    "batch_traceability",
    "quality_acceptance_criteria",
    "regulatory_and_ip_review"
  ],
  "minimum_external_evidence_fields": [
    "evidence_id",
    "source",
    "date",
    "independent_reviewer",
    "sha256"
  ],
  "forbid_self_attested_external_gates": true,
  "physical_synthesis_executed_by_this_repo": false,
  "supported_design_routes": [
    "small_molecule_rdkit",
    "periodic_crystal_geometry",
    "structural_modeler"
  ]
}
