  "verified_evaluator_boundary": {
    "trusted_policy_files": [
      "config/experiment_policy.json",
      "config/auto_promotion_scope.json",
      "config/math_discovery_policy.json",
      "config/avrea_half_month_budget.json"
    ],
    "never_candidate_writable": [
      ".github/",
      "scripts/",
      "tests/",
      "config/collar_policy.json",
      "config/compute_policy.json",
      "config/experiment_policy.json"
    ],
    "enforce_existing_promotion_gates": true,
    "candidate_strategy": "data_only until separate collared runtime qualifies",
    "holdout_mutable_by_candidate": false,
    "browser_content_untrusted": true,
    "model_changes_require_existing_scope_validator": true,
    "auto_promotion_requires_independent_existing_qualification": true,
    "external_cace_repository_requires_separate_qualification": true
