{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/research_object_spec.schema.json",
  "title": "CACE Research Object Specification",
  "description": "Typed specification for AI-generated physical research objects. Inspired by public NASA generative-design workflows: preserve geometry, obstacle/keep-out geometry, explicit requirements, iterative simulation, and manufacturability validation. This schema does not implement or copy any patented algorithm.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "purpose",
    "design_space",
    "preserve_geometry",
    "obstacle_geometry",
    "materials",
    "physics",
    "objectives",
    "constraints",
    "generation",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "design_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "bounds",
        "representation"
      ],
      "properties": {
        "coordinate_frame": {
          "type": "string"
        },
        "bounds": {
          "type": "object"
        },
        "representation": {
          "enum": [
            "exact_csg",
            "parametric",
            "implicit_sdf",
            "voxel",
            "surface_mesh",
            "volume_mesh",
            "hybrid"
          ]
        },
        "symmetry_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "preserve_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "geometry_ref",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "geometry_ref": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "must_remain_exact": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "obstacle_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "geometry_ref",
          "clearance_m"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "geometry_ref": {
            "type": "string"
          },
          "clearance_m": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "model"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "density_kg_m3": {
            "type": [
              "number",
              "null"
            ]
          },
          "youngs_modulus_pa": {
            "type": [
              "number",
              "null"
            ]
          },
          "poisson_ratio": {
            "type": [
              "number",
              "null"
            ]
          },
          "thermal_conductivity_w_mk": {
            "type": [
              "number",
              "null"
            ]
          },
          "electrical_conductivity_s_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "relative_permittivity": {
            "type": [
              "number",
              "null"
            ]
          },
          "relative_permeability": {
            "type": [
              "number",
              "null"
            ]
          },
          "provenance": {
            "type": "string"
          }
        }
      }
    },
    "physics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "linear_elasticity",
          "nonlinear_elasticity",
          "modal",
          "acoustic",
          "maxwell",
          "magnetostatic",
          "electrostatic",
          "heat",
          "fluid",
          "optics",
          "coupled_multiphysics"
        ]
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "direction",
          "weight"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "minimize",
              "maximize",
              "target"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical",
        "manufacturing",
        "safety"
      ],
      "properties": {
        "physical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manufacturing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_feature_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "maximum_mass_kg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "population_limit",
        "novelty_archive"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "parameter_sweep",
              "gradient_shape_optimization",
              "topology_optimization",
              "evolutionary_search",
              "quality_diversity",
              "surrogate_model",
              "symbolic_geometry_rewrite"
            ]
          }
        },
        "population_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "novelty_archive": {
          "type": "boolean"
        },
        "seed_policy": {
          "type": "string"
        },
        "mutation_budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cace_pipeline",
        "interval_bound_required",
        "holdout_required",
        "fabrication_simulation_required"
      ],
      "properties": {
        "cace_pipeline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interval_bound_required": {
          "type": "boolean"
        },
        "holdout_required": {
          "type": "boolean"
        },
        "fabrication_simulation_required": {
          "type": "boolean"
        },
        "formal_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "geometry_catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "xyz_m"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "xyz_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "obstacle_boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "min_xyz_m",
              "max_xyz_m"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "min_xyz_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "max_xyz_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
