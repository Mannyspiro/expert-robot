{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/physics_experiment_spec.schema.json",
  "title": "CACE Physics Experiment Specification",
  "description": "Typed, simulation-first description of a physics experiment including apparatus, sources, fields, controls, observables, uncertainty, and adaptive experimental search.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","experiment_id","hypothesis","apparatus",
    "domains","sources","boundary_conditions","observables",
    "controls","parameter_space","simulation","uncertainty","adaptive_search"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "experiment_id": {"type": "string","minLength": 1},
    "hypothesis": {
      "type": "object",
      "required": ["statement","null_model","alternative_models"],
      "properties": {
        "statement": {"type": "string"},
        "null_model": {"type": "string"},
        "alternative_models": {"type": "array","items":{"type":"string"}}
      }
    },
    "apparatus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "enum": [
              "research_object","sample","source","detector","waveguide","cavity",
              "electrode","magnet","coil","mirror","lens","fluid_cell",
              "thermal_stage","mechanical_fixture","vacuum_region","shield","other"
            ]
          },
          "geometry_ref": {"type": ["string","null"]},
          "matter_ref": {"type": ["string","null"]},
          "calibration_ref": {"type": ["string","null"]},
          "metadata": {"type": "object"}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "classical_mechanics","elasticity","acoustics","electrostatics",
          "magnetostatics","electromagnetism","optics","heat_transfer",
          "fluid_dynamics","plasma","statistical_mechanics","condensed_matter",
          "quantum_model","relativity_model","multiphysics"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","source_type","profile"],
        "properties": {
          "id": {"type": "string"},
          "source_type": {
            "enum": [
              "force","torque","pressure","heat_flux","current","voltage",
              "charge","magnetic_field","electric_field","em_wave",
              "acoustic_wave","optical_wave","mass_flow","initial_condition"
            ]
          },
          "profile": {"type": "object"},
          "sweepable": {"type": "boolean"}
        }
      }
    },
    "boundary_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region_ref","condition"],
        "properties": {
          "region_ref": {"type": "string"},
          "condition": {"type": "string"},
          "value": {"type": ["object","number","string","null"]}
        }
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name","quantity","location","units"],
        "properties": {
          "name": {"type": "string"},
          "quantity": {"type": "string"},
          "location": {"type": "string"},
          "units": {"type": "string"},
          "sampling": {"type": "object"},
          "detector_ref": {"type": ["string","null"]}
        }
      }
    },
    "controls": {
      "type": "object",
      "required": ["negative_controls","positive_controls","randomization","blinding"],
      "properties": {
        "negative_controls": {"type": "array","items":{"type":"string"}},
        "positive_controls": {"type": "array","items":{"type":"string"}},
        "randomization": {"type": "boolean"},
        "blinding": {"enum":["none","single","double","automated"]}
      }
    },
    "parameter_space": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name","kind"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum":["continuous","integer","categorical","geometry","material"]},
          "bounds": {"type": ["array","null"]},
          "choices": {"type": ["array","null"]},
          "units": {"type": ["string","null"]}
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["cace_pipeline","solvers","cross_model_checks","certificate_required"],
      "properties": {
        "cace_pipeline": {"type":"array","items":{"type":"string"}},
        "solvers": {"type":"array","items":{"type":"string"}},
        "cross_model_checks": {"type":"array","items":{"type":"string"}},
        "certificate_required": {"type":"boolean"},
        "formal_properties": {"type":"array","items":{"type":"string"}}
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["instrument","model","numerical","environmental"],
      "properties": {
        "instrument": {"type":"array","items":{"type":"string"}},
        "model": {"type":"array","items":{"type":"string"}},
        "numerical": {"type":"array","items":{"type":"string"}},
        "environmental": {"type":"array","items":{"type":"string"}},
        "combine_policy": {"type":"string"}
      }
    },
    "adaptive_search": {
      "type": "object",
      "required": ["enabled","objective","max_rounds","selection_policy"],
      "properties": {
        "enabled": {"type":"boolean"},
        "objective": {"type":"string"},
        "max_rounds": {"type":"integer","minimum":1},
        "selection_policy": {
          "enum":[
            "information_gain",
            "bayesian_optimization",
            "quality_diversity",
            "active_learning",
            "uncertainty_reduction",
            "multiobjective"
          ]
        },
        "stop_conditions": {"type":"array","items":{"type":"string"}}
      }
    }
  }
}
