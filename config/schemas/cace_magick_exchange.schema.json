{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/cace_magick_exchange.schema.json",
  "title": "CACE Magick Experiment Exchange",
  "description": "Fail-closed exchange format between Magick IR research orchestration and a CACE numerical/certification backend.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "experiment_id",
        "source_sha256",
        "exact_geometry",
        "models",
        "requested_certificates"
      ],
      "properties": {
        "kind": {"const": "cace_magick_request"},
        "schema_version": {"const": 1},
        "experiment_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exact_geometry": {"type": "object"},
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "observable", "assumptions"],
            "properties": {
              "domain": {
                "enum": [
                  "acoustic_wave",
                  "maxwell_em",
                  "magnetostatic",
                  "heat",
                  "elastic_vibration",
                  "optics",
                  "fluid",
                  "chemical",
                  "sensor_noise"
                ]
              },
              "observable": {"type": "string", "minLength": 1},
              "assumptions": {"type": "array", "items": {"type": "string"}},
              "boundary_conditions": {"type": "array", "items": {"type": "object"}},
              "materials": {"type": "array", "items": {"type": "object"}}
            }
          }
        },
        "requested_certificates": {
          "type": "array",
          "items": {
            "enum": [
              "mesh_validity",
              "solver_status",
              "residual",
              "a_posteriori_error",
              "interval_bound",
              "input_identity"
            ]
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "experiment_id",
        "source_sha256",
        "status",
        "model_results",
        "certificate",
        "evidence_ceiling"
      ],
      "properties": {
        "kind": {"const": "cace_magick_response"},
        "schema_version": {"const": 1},
        "experiment_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "PARTIAL"]},
        "model_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "solver_status", "residual_bound", "limitations"],
            "properties": {
              "domain": {"type": "string"},
              "solver_status": {"enum": ["CONVERGED", "FAILED", "NOT_RUN"]},
              "residual_bound": {
                "type": ["object", "null"],
                "properties": {
                  "norm": {"type": "string"},
                  "upper": {"type": "number", "minimum": 0},
                  "units": {"type": "string"},
                  "confidence_or_rigor": {"type": "string"}
                }
              },
              "limitations": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_identity_bound", "assumptions_bound", "claim_bound"],
          "properties": {
            "input_identity_bound": {"type": "boolean"},
            "assumptions_bound": {"type": "boolean"},
            "claim_bound": {"type": "boolean"},
            "artifact_digest": {"type": ["string", "null"]},
            "proof_status": {"type": ["string", "null"]}
          }
        },
        "evidence_ceiling": {
          "const": "known_physics_model_result_not_new_physics"
        }
      }
    }
  }
}
