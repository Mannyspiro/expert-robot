{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "namespace",
    "binders",
    "proposition",
    "imports",
    "domain",
    "rationale"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binders": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "proposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rationale": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
