{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/verified_optimization_rule.schema.json",
  "title": "Verified CACE Optimization Rule",
  "description": "An optimization rule whose semantic correctness is backed by formal proof and whose efficiency value is backed by benchmark/ablation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","rule_id","theorem_refs","rewrite_or_reduction",
    "applicability","benchmark","safety","stage"
  ],
  "properties": {
    "schema_version": {"const":"0.1"},
    "rule_id": {"type":"string","minLength":1},
    "theorem_refs": {
      "type":"array","minItems":1,
      "items":{"type":"string","minLength":1}
    },
    "rewrite_or_reduction": {
      "type":"object",
      "required":["kind","before","after"],
      "properties": {
        "kind": {
          "enum":[
            "canonicalize","reduce_domain","prune_search","reuse_operator",
            "reuse_solution","factorize","replace_kernel","tighten_bound"
          ]
        },
        "before":{"type":"string"},
        "after":{"type":"string"}
      }
    },
    "applicability": {
      "type":"object",
      "required":["preconditions","fail_closed"],
      "properties": {
        "preconditions":{"type":"array","items":{"type":"string"}},
        "fail_closed":{"const":true}
      }
    },
    "benchmark": {
      "type":"object",
      "required":[
        "suite","cases","speedup","memory_ratio","verified_non_regression",
        "blind_holdout_non_regression"
      ],
      "properties": {
        "suite":{"type":"string"},
        "cases":{"type":"integer","minimum":1},
        "speedup":{"type":"number","exclusiveMinimum":0},
        "memory_ratio":{"type":"number","exclusiveMinimum":0},
        "verified_non_regression":{"type":"boolean"},
        "blind_holdout_non_regression":{"type":"boolean"},
        "notes":{"type":"string"}
      }
    },
    "safety": {
      "type":"object",
      "required":[
        "authority_delta","rollback_verified","core_integrity_verified"
      ],
      "properties": {
        "authority_delta":{"const":0},
        "rollback_verified":{"type":"boolean"},
        "core_integrity_verified":{"type":"boolean"}
      }
    },
    "stage": {
      "enum":["EXPERIMENTAL","PROVEN_NOT_BENCHMARKED","QUALIFIED","RETIRED"]
    }
  }
}
