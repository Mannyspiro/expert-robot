{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/experiment_math_candidate.schema.json",
  "title": "Experiment-Inspired Mathematics Candidate",
  "description": "A conjecture or mathematical structure suggested by experimental/simulation data. Data may inspire a candidate but never upgrades it to a theorem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","candidate_id","source_evidence","pattern_class",
    "informal_statement","formalization_target","proof_obligations",
    "optimization_hypothesis","status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "candidate_id": {"type": "string","minLength": 1},
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256","generator","sample_count","holdout_sealed"],
      "properties": {
        "artifact_sha256": {"type": "string","pattern": "^[0-9a-f]{64}$"},
        "generator": {"type": "string"},
        "sample_count": {"type": "integer","minimum": 1},
        "holdout_sealed": {"type": "boolean"},
        "domains": {"type": "array","items":{"type":"string"}}
      }
    },
    "pattern_class": {
      "enum": [
        "symmetry","invariance","scaling_law","monotonicity","conservation",
        "reciprocity","duality","separability","low_rank","sparsity",
        "periodicity","topological_invariant","operator_factorization",
        "error_bound","dimensionless_group","recurrence","other"
      ]
    },
    "informal_statement": {"type": "string","minLength": 1},
    "empirical_support": {
      "type": "object",
      "properties": {
        "fit_score": {"type": ["number","null"],"minimum":0,"maximum":1},
        "max_observed_residual": {"type": ["number","null"],"minimum":0},
        "counterexamples_found": {"type": "integer","minimum":0},
        "notes": {"type": "string"}
      }
    },
    "formalization_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain","lean_namespace","quantifiers","assumptions","conclusion"],
      "properties": {
        "domain": {"type": "string"},
        "lean_namespace": {"type": "string"},
        "quantifiers": {"type": "array","items":{"type":"string"}},
        "assumptions": {"type": "array","items":{"type":"string"}},
        "conclusion": {"type": "string"}
      }
    },
    "proof_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "optimization_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism","expected_gain","correctness_dependency"],
      "properties": {
        "mechanism": {
          "enum": [
            "symmetry_reduction","cache_canonicalization","search_pruning",
            "operator_reuse","reduced_basis","domain_reduction",
            "mesh_reduction","factorized_solve","bound_pruning",
            "normalization_reuse","specialized_kernel","other"
          ]
        },
        "expected_gain": {"type": "string"},
        "correctness_dependency": {"type": "string"},
        "benchmark_suite": {"type": "array","items":{"type":"string"}}
      }
    },
    "status": {
      "enum": [
        "INSPIRED","FORMALIZED","PROOF_SEARCH","PROVEN","REFUTED",
        "BENCHMARKING","QUALIFIED_OPTIMIZATION","REJECTED"
      ]
    },
    "proof_ref": {"type": ["string","null"]},
    "lineage": {"type": "array","items":{"type":"string"}}
  }
}
