{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/research_matter_graph.schema.json",
  "title": "CACE Research Matter Graph",
  "description": "Typed multiscale matter representation from atoms and bonds through molecules, biomolecules, crystals, metamaterials, materials, assemblies, and computational biomachines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","matter_id","nodes","edges","scales","verification"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "matter_id": {"type": "string","minLength": 1},
    "description": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","kind"],
        "properties": {
          "id": {"type": "string","minLength": 1},
          "kind": {
            "enum": [
              "atom","bond","molecule","polymer","amino_acid","protein",
              "nucleotide","dna","rna","lipid","carbohydrate","ligand",
              "crystal_unit_cell","lattice","grain","phase","composite",
              "metamaterial_unit_cell","metamaterial_bulk",
              "device","assembly","biomachine"
            ]
          },
          "element": {"type": ["string","null"]},
          "isotope": {"type": ["integer","null"],"minimum": 1},
          "formal_charge": {"type": ["integer","null"]},
          "position": {
            "type": ["array","null"],
            "items": {"type": "string"},
            "minItems": 3,
            "maxItems": 3
          },
          "sequence": {"type": ["string","null"]},
          "structure_ref": {"type": ["string","null"]},
          "composition": {"type": ["object","null"]},
          "unit_cell": {"type": ["object","null"]},
          "geometry_ref": {"type": ["string","null"]},
          "material_model_ref": {"type": ["string","null"]},
          "effective_properties": {"type": ["object","null"]},
          "metadata": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source","target","relation"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {
            "enum": [
              "bonded_to","contains","sequence_next","folds_into","packs_with",
              "repeats_as","interfaces_with","embedded_in","coats",
              "loads","couples_to","constrains"
            ]
          },
          "bond_order": {"type": ["number","null"],"minimum": 0},
          "bond_type": {"type": ["string","null"]},
          "periodic_image": {"type": ["array","null"],"items":{"type":"integer"},"minItems":3,"maxItems":3},
          "metadata": {"type": "object"}
        }
      }
    },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "electronic","atomic","molecular","mesoscopic",
          "unit_cell","microstructure","continuum","device","system"
        ]
      }
    },
    "metamaterial": {
      "type": ["object","null"],
      "properties": {
        "periodic": {"type": "boolean"},
        "lattice_vectors": {"type": "array","items":{"type":"array","items":{"type":"string"},"minItems":3,"maxItems":3}},
        "unit_cell_ref": {"type": ["string","null"]},
        "homogenization_required": {"type": "boolean"},
        "target_effective_properties": {"type": "object"},
        "band_structure_required": {"type": "boolean"},
        "topological_invariants_required": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chemistry_validity","geometry_validity","physics_models","provenance_required"],
      "properties": {
        "chemistry_validity": {"type": "boolean"},
        "geometry_validity": {"type": "boolean"},
        "physics_models": {"type": "array","items":{"type":"string"}},
        "provenance_required": {"const": true},
        "formal_constraints": {"type": "array","items":{"type":"string"}},
        "wet_lab_instructions_allowed": {"const": false}
      }
    }
  }
}
