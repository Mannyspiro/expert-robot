{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-robot.local/schemas/protocol_feature_matrix.schema.json",
  "title": "Witness-Conditioned Protocol Feature Matrix",
  "description": "Data model for testing whether historically transmitted ritual/alchemical features track claimed function after phylogenetic dependence is capped.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","functions","witnesses","features","observations"],
  "properties": {
    "schema_version": {"const": 1},
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {"type":"string","minLength":1},
      "uniqueItems": true
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required":["id","independence_group","weight","claimed_functions"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "independence_group":{"type":"string","minLength":1},
          "weight":{"type":"number","minimum":0,"maximum":1},
          "claimed_functions":{
            "type":"array",
            "items":{"type":"string"},
            "uniqueItems":true
          },
          "notes":{"type":"string"}
        }
      }
    },
    "features": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["id","class","description"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "class":{
            "enum":[
              "topology","geometry_metric","symbol_identity","symbol_order",
              "material","orientation","timing","process","scribal_error","other"
            ]
          },
          "description":{"type":"string"},
          "experimental_channel":{"type":["string","null"]}
        }
      }
    },
    "observations": {
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["witness","feature","state","confidence","status"],
        "properties":{
          "witness":{"type":"string"},
          "feature":{"type":"string"},
          "state":{"type":"string"},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "status":{"enum":["observed","inferred","disputed","missing","exclusion"]},
          "notes":{"type":"string"}
        }
      }
    }
  }
}
