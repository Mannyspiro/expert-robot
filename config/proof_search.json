{
  "schema_version": 1,
  "strategies": [
    "simp",
    "norm_num",
    "norm_num [MathAI.Geometry.pointOnPlane, MathAI.Geometry.dot, MathAI.Geometry.pointVec]",
    "norm_num [MathAI.Geometry.pointOnLine, MathAI.Geometry.cross, MathAI.Geometry.vecBetween, MathAI.Geometry.zeroVec]",
    "norm_num [MathAI.Geometry.pointOnSphere, MathAI.Geometry.squaredDistance]",
    "norm_num [MathAI.Geometry.orthogonal, MathAI.Geometry.dot]",
    "simp [MathAI.Geometry.dot, MathAI.Geometry.zeroVec]",
    "ext <;> simp [MathAI.Geometry.cross, MathAI.Geometry.zeroVec] <;> ring",
    "simp [MathAI.Geometry.orthogonal, MathAI.Geometry.dot, MathAI.Geometry.zeroVec]",
    "unfold MathAI.Geometry.squaredDistance; ring",
    "unfold MathAI.Geometry.squaredDistance; positivity",
    "simp [MathAI.Geometry.orthogonal, MathAI.Geometry.dot, mul_comm, add_comm, add_left_comm, add_assoc]",
    "simp [MathAI.Geometry.pointOnSphere] at * <;> aesop",
    "ring",
    "ring_nf",
    "linarith",
    "nlinarith",
    "omega",
    "positivity",
    "aesop",
    "exact?",
    "apply?",
    "solve_by_elim",
    "first | exact? | assumption | simp_all | aesop",
    "constructor <;> first | exact? | assumption | simp_all | aesop",
    "intro <;> first | exact? | assumption | simp_all | aesop",
    "symm <;> first | exact? | assumption | simp_all | aesop",
    "rw? <;> first | exact? | assumption | simp_all | aesop",
    "ext <;> simp_all <;> try ring <;> try linarith <;> try aesop",
    "simp_all <;> try ring_nf <;> try nlinarith <;> try aesop"
  ],
  "timeout_seconds": 20
}
