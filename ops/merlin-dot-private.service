[Unit]
Description=Merlin private engineering tool host
After=local-fs.target

[Service]
Type=simple
User=merlin-dot
Group=opc
WorkingDirectory=/opt/merlin-dot-private/current
Environment=PYTHONPATH=/opt/merlin-dot-private/current/python:/opt/merlin-dot-private/current/runtime-reference/python
ExecStart=/usr/bin/python3 -m dot_ai_os.private_runtime serve --root /var/lib/merlin-dot-private/state --socket /run/merlin-dot-private/tools.sock --config /etc/merlin-dot-private/config.json --simulation-demo
RuntimeDirectory=merlin-dot-private
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/merlin-dot-private/state
MemoryMax=384M
TasksMax=32
CPUQuota=100%
UMask=0077

[Install]
WantedBy=multi-user.target
