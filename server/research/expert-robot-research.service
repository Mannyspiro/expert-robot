[Unit]
Description=Expert Robot Plesk server research observer (no GitHub Actions)
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathIsDirectory=/opt/expert-robot/git/expert-robot
ConditionPathExists=/etc/expert-robot-forge/worker.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/expert-robot-forge/worker.env
WorkingDirectory=/opt/expert-robot/git/expert-robot
ExecStart=/usr/bin/python3 /opt/expert-robot/worker/worker.py --repo /opt/expert-robot/git/expert-robot --origin ssh://git@127.0.0.1:2222/Mannyspiro/expert-robot.git --ref refs/heads/main --state /var/lib/expert-robot/research
TimeoutStartSec=380
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/expert-robot/git /var/lib/expert-robot/research
StandardOutput=journal
StandardError=journal
