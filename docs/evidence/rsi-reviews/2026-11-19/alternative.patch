+def png_candidate_size(candidate):
+    """Check fixed PNG identity and its pixel budget before any image plugin."""
+    if (len(candidate) < 33 or candidate[:8] != b"\x89PNG\r\n\x1a\n"
+            or candidate[8:16] != b"\x00\x00\x00\rIHDR"):
+        raise ValueError("expected a PNG signature and complete first IHDR chunk")
+    width = int.from_bytes(candidate[16:20], "big")
+    height = int.from_bytes(candidate[20:24], "big")
+    if width < 1 or height < 1 or width * height > 24_000_000:
+        raise ValueError("expected a PNG within the candidate pixel budget")
+    return width, height
+
