+"""Public synthetic development checks, separate from independent evaluation."""
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from PIL import Image, ImageDraw
+
+from merlin.drafting_control import CHECKS, guide_files, review_wiring
+from merlin.drafting_topology import terminal_topology
+from merlin.wiring_sheet import read_sheet, wire_svg
+
+
+FIXTURE = Path(__file__).resolve().parents[1] / "examples/merlin/lab-signal-sheet.json"
+
+
+class TerminalTopologyTests(unittest.TestCase):
+    def setUp(self):
+        self.controls = {
+            "canvas_px": [1536, 1024],
+            "sheet_px_per_mm": 4,
+            "pins_px": {"A": [200, 300], "B": [700, 300], "C": [1000, 300],
+                        "D": [200, 700], "E": [1000, 700]},
+            "nets": {"top": [{"from": "A", "to": "B"}, {"from": "B", "to": "C"}],
+                     "bottom": [{"from": "D", "to": "E"}]},
+        }
+        self.image = Image.new("RGB", (1536, 1024), "white")
+        draw = ImageDraw.Draw(self.image)
+        draw.line([(200, 300), (1000, 300)], fill="#146564", width=4)
+        draw.line([(200, 700), (1000, 700)], fill="#146564", width=4)
+        for x, y in self.controls["pins_px"].values():
+            draw.ellipse((x - 3, y - 3, x + 3, y + 3), fill="white", outline="#263e48")
+
+    def test_branch_and_pin_holes_match_terminal_partition(self):
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "consistent_with_expected_connectivity")
+        self.assertFalse(result["qualification"])
+        self.assertFalse(result["promotion_authority"])
+
+    def test_broken_conductor_contradicts(self):
+        ImageDraw.Draw(self.image).rectangle((400, 290, 430, 310), fill="white")
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "contradicted")
+        self.assertIn("top", result["split_source_nets"])
+
+    def test_joined_separate_nets_contradict(self):
+        ImageDraw.Draw(self.image).line([(500, 300), (500, 700)], fill="#146564", width=4)
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "contradicted")
+        self.assertIn(["bottom", "top"], result["joined_source_nets"])
+
+    def test_missing_terminal_stroke_contradicts(self):
+        ImageDraw.Draw(self.image).rectangle((180, 680, 240, 720), fill="white")
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "contradicted")
+        self.assertIn("D", result["missing_terminal_strokes"])
+
+    def test_unknown_palette_abstains(self):
+        self.assertEqual(terminal_topology(Image.new("RGB", (1536, 1024), "white"), self.controls)["status"], "abstain")
+
+    def test_wrong_registration_and_nonfinite_scale_abstain(self):
+        self.assertEqual(terminal_topology(self.image.resize((768, 512)), self.controls)["status"], "abstain")
+        controls = copy.deepcopy(self.controls)
+        controls["sheet_px_per_mm"] = float("nan")
+        self.assertEqual(terminal_topology(self.image, controls)["status"], "abstain")
+
+    def test_unassigned_stroke_abstains(self):
+        ImageDraw.Draw(self.image).line([(1100, 850), (1200, 850)], fill="#146564", width=4)
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "abstain")
+        self.assertEqual(result["reason"], "unassigned_strokes_require_review")
+
+    def test_gray_component_and_label_strokes_do_not_join_nets(self):
+        ImageDraw.Draw(self.image).line([(500, 300), (500, 700)], fill="#263e48", width=1)
+        self.assertEqual(terminal_topology(self.image, self.controls)["status"], "consistent_with_expected_connectivity")
+
+    def test_same_net_dangling_branch_is_explicit_limit(self):
+        ImageDraw.Draw(self.image).line([(500, 300), (500, 450)], fill="#146564", width=4)
+        result = terminal_topology(self.image, self.controls)
+        self.assertEqual(result["status"], "consistent_with_expected_connectivity")
+        self.assertIn("extra same-net branches can be invisible", " ".join(result["limits"]))
+
+
+class RegisteredPublicControlTests(unittest.TestCase):
+    def test_opt_in_preserves_default_and_gates_unknown_palette(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            raw = FIXTURE.read_bytes()
+            title, _, parts, pins, nets = read_sheet(raw)
+            svg = wire_svg(title, parts, pins, nets)
+            (root / "wiring.svg").write_bytes(svg)
+            for name, content in guide_files(raw, svg, nets).items():
+                (root / name).write_bytes(content)
+            controls = json.loads((root / "draft-controls.json").read_bytes())
+            verdict = {
+                "schema": "merlin-drafting-verdict/1", "reviewer": "synthetic development fixture",
+                "notes": "Public control only; not an independent review or physical wiring claim.",
+                "source_sha256": controls["source_sha256"], "guide_sha256": controls["guide_sha256"],
+                "checks": dict.fromkeys(CHECKS, "pass"),
+                "nets": [{"id": name, "status": "pass", "connections": [
+                    {"from": row["from"], "to": row["to"], "status": "pass"} for row in rows]}
+                    for name, rows in controls["nets"].items()],
+            }
+            positive = root / "conditioning-guide.png"
+            verdict["image_sha256"] = hashlib.sha256(positive.read_bytes()).hexdigest()
+            path = root / "verdict.json"
+            path.write_text(json.dumps(verdict))
+            result = review_wiring(FIXTURE, root, positive, path, root / "positive", topology_check=True)
+            self.assertEqual(result["decision"], "accepted")
+            self.assertEqual(result["topology_check"]["status"], "consistent_with_expected_connectivity")
+
+            blank = root / "blank.png"
+            Image.new("RGB", (1536, 1024), "white").save(blank)
+            verdict["image_sha256"] = hashlib.sha256(blank.read_bytes()).hexdigest()
+            path.write_text(json.dumps(verdict))
+            default = review_wiring(FIXTURE, root, blank, path, root / "default")
+            gated = review_wiring(FIXTURE, root, blank, path, root / "gated", topology_check=True)
+            self.assertEqual(default["decision"], "accepted")
+            self.assertNotIn("topology_check", default)
+            self.assertEqual(gated["decision"], "rejected")
+            self.assertEqual(gated["topology_check"]["status"], "abstain")
+
+
+if __name__ == "__main__":
+    unittest.main()
