+"""Conservative topology screen for the fixed registered wiring-sheet palette.
+
+This checks only terminal connected partitions in a decoded raster. It is not a
+visual semantic reviewer, OCR system, or physical connectivity qualification.
+Unsupported registration/palette and substantial unassigned strokes abstain.
+"""
+
+from array import array
+from collections import defaultdict, deque
+import math
+
+
+CANVAS = (1536, 1024)
+MAX_INK_PIXELS = 200_000
+
+
+def terminal_topology(image, controls):
+    """Return a bounded diagnostic, never an approval or promotion decision."""
+    result = {
+        "schema": "merlin-registered-terminal-topology/1",
+        "status": "abstain",
+        "reason": "unsupported_registration",
+        "authority": "registered raster topology screen only",
+        "qualification": False,
+        "promotion_authority": False,
+        "limits": [
+            "Known teal palette and exact canvas; no alignment or OCR.",
+            "Terminal connectivity only; extra same-net branches can be invisible.",
+            "Raster adjacency is not physical wiring qualification.",
+        ],
+    }
+    if image.size != CANVAS or controls.get("canvas_px") != list(CANVAS):
+        return result
+    scale = controls.get("sheet_px_per_mm")
+    if isinstance(scale, bool) or not isinstance(scale, (int, float)):
+        return result
+    if not math.isfinite(scale) or not 0.5 <= scale <= 30:
+        return result
+    nets = controls.get("nets")
+    pins = controls.get("pins_px")
+    if not isinstance(nets, dict) or not 1 <= len(nets) <= 64 or not isinstance(pins, dict):
+        return result
+    expected = {}
+    for net, routes in nets.items():
+        if not isinstance(net, str) or not isinstance(routes, list) or not 1 <= len(routes) <= 64:
+            return result
+        for route in routes:
+            if not isinstance(route, dict):
+                return result
+            for field in ("from", "to"):
+                pin = route.get(field)
+                if not isinstance(pin, str) or pin not in pins:
+                    return result
+                if pin in expected and expected[pin] != net:
+                    return result
+                expected[pin] = net
+    if not 2 <= len(expected) <= 1152:
+        return result
+    for pin in expected:
+        point = pins[pin]
+        if not isinstance(point, list) or len(point) != 2:
+            return result
+        for coordinate, ceiling in zip(point, CANVAS):
+            if isinstance(coordinate, bool) or not isinstance(coordinate, (int, float)):
+                return result
+            if not math.isfinite(coordinate) or not 0 <= coordinate < ceiling:
+                return result
+
+    width, height = CANVAS
+    pixels = image.convert("RGB").tobytes()
+    mask = bytearray(width * height)
+    count = 0
+    for index in range(width * height):
+        red, green, blue = pixels[index * 3:index * 3 + 3]
+        if green - red >= 35 and blue - red >= 25 and abs(green - blue) <= 45 and min(green, blue) >= 40:
+            count += 1
+            if count > MAX_INK_PIXELS:
+                result["reason"] = "ink_budget_or_palette_outside_profile"
+                return result
+            mask[index] = 1
+    if count == 0:
+        result["reason"] = "known_stroke_palette_not_observed"
+        return result
+
+    labels = array("I", [0]) * (width * height)
+    sizes = [0]
+    for start in range(width * height):
+        if not mask[start] or labels[start]:
+            continue
+        label = len(sizes)
+        labels[start] = label
+        queue = deque([start])
+        size = 0
+        while queue:
+            current = queue.popleft()
+            size += 1
+            x, y = current % width, current // width
+            for row in range(max(0, y - 1), min(height, y + 2)):
+                for column in range(max(0, x - 1), min(width, x + 2)):
+                    adjacent = row * width + column
+                    if mask[adjacent] and not labels[adjacent]:
+                        labels[adjacent] = label
+                        queue.append(adjacent)
+        sizes.append(size)
+
+    parent = list(range(len(sizes) + len(expected)))
+
+    def find(node):
+        while parent[node] != node:
+            parent[node] = parent[parent[node]]
+            node = parent[node]
+        return node
+
+    def union(left, right):
+        parent[find(left)] = find(right)
+
+    # Source pin circles have radius .7mm and a .35mm centered gray ring.
+    # Probe beyond that opaque boundary plus two pixels for raster rounding.
+    radius = math.ceil((0.7 + 0.35 / 2) * scale) + 2
+    terminal_nodes = {}
+    assigned = set()
+    missing = []
+    for offset, pin in enumerate(sorted(expected)):
+        node = len(sizes) + offset
+        terminal_nodes[pin] = node
+        x, y = pins[pin]
+        nearby = set()
+        for row in range(max(0, math.floor(y - radius)), min(height, math.ceil(y + radius) + 1)):
+            for column in range(max(0, math.floor(x - radius)), min(width, math.ceil(x + radius) + 1)):
+                if (column - x) ** 2 + (row - y) ** 2 <= radius ** 2:
+                    label = labels[row * width + column]
+                    if label:
+                        nearby.add(label)
+        if not nearby:
+            missing.append(pin)
+        for label in nearby:
+            assigned.add(label)
+            union(node, label)
+
+    result.update(component_count=len(sizes) - 1, terminal_count=len(expected))
+    if len(missing) == len(expected):
+        result["reason"] = "no_strokes_near_registered_terminals"
+        return result
+    source_roots = defaultdict(set)
+    observed_nets = defaultdict(set)
+    for pin, net in expected.items():
+        root = find(terminal_nodes[pin])
+        source_roots[net].add(root)
+        observed_nets[root].add(net)
+    split = sorted(net for net, roots in source_roots.items() if len(roots) > 1)
+    joined = sorted(sorted(names) for names in observed_nets.values() if len(names) > 1)
+    result.update(missing_terminal_strokes=missing, split_source_nets=split, joined_source_nets=joined)
+    if missing or split or joined:
+        result.update(status="contradicted", reason="registered_terminal_partitions_differ")
+        return result
+    stray = [size for label, size in enumerate(sizes) if label and label not in assigned and size >= max(24, round(scale ** 2))]
+    if stray:
+        result.update(reason="unassigned_strokes_require_review", unassigned_component_sizes=stray)
+        return result
+    result.update(status="consistent_with_expected_connectivity", reason="observed_terminal_partitions_match_source_nets")
+    return result
