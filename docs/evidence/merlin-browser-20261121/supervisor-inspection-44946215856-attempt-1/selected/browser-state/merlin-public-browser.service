[Unit]
Description=Merlin bounded public research browser
After=network.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=merlin-public-browser
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/opt/merlin-public-browser/releases/5b967b6364bb8d3213c357e148c43073c309ab45d13338fe577d13565f8d0e9d/venv/bin/python -I -B -c "import sys;sys.path.insert(0,'/opt/merlin-public-browser/releases/5b967b6364bb8d3213c357e148c43073c309ab45d13338fe577d13565f8d0e9d/python');from merlin.browser_service import main;raise SystemExit(main())" --config /etc/merlin-public-browser/service.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/empty
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=control-group
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
RestrictAddressFamilies=AF_UNIX
ProtectHome=no
PrivateTmp=no
[Install]
WantedBy=multi-user.target
