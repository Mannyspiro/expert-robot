          "meaning": "uncertainty set",
          "unit": "same space as u",
          "dimension": "same as u"
        },
        {
          "symbol": "f",
          "meaning": "loss/cost",
          "unit": "objective-unit",
          "dimension": "objective dimension"
        }
      ],
      "assumptions": [
        "Uncertainty set is defensible",
        "Worst-case objective is appropriate",
