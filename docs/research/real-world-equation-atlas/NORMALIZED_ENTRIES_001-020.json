  "entries": [
    {
      "id": "RWEA-001",
      "domain": "optimization",
      "equation": "minimize f(x) subject to g_i(x)<=0 and h_j(x)=0",
      "variables": [
        {
          "symbol": "x",
          "meaning": "decision vector",
          "unit": "application-defined",
          "dimension": "application-defined"
        },
        {
          "symbol": "f",
          "meaning": "objective/cost",
          "unit": "application-defined",
          "dimension": "application-defined"
        },
        {
          "symbol": "g_i",
          "meaning": "inequality constraint functions",
          "unit": "constraint-specific",
          "dimension": "constraint-specific"
        },
        {
          "symbol": "h_j",
          "meaning": "equality constraint functions",
          "unit": "constraint-specific",
          "dimension": "constraint-specific"
        }
      ],
      "assumptions": [
        "Feasible set is defined",
        "Objective and constraints are measurable and well-posed",
        "Units are consistent within each function",
        "Global optimality requires suitable convexity or exhaustive certification"
      ],
      "conditions": [
        "State whether local or global optimum is sought"
      ],
      "sources": [
        "S01",
        "S02"
      ]
    },
    {
      "id": "RWEA-002",
      "domain": "optimization",
      "equation": "minimize c^T x subject to A x <= b and x >= 0",
      "variables": [
        {
          "symbol": "x_j",
          "meaning": "decision variable",
          "unit": "x_j-specific",
          "dimension": "declared per variable"
        },
        {
          "symbol": "c_j",
          "meaning": "objective coefficient",
          "unit": "currency/x_j or objective-unit/x_j",
          "dimension": "objective/x_j"
        },
        {
          "symbol": "A_ij",
          "meaning": "constraint coefficient",
          "unit": "b_i/x_j",
          "dimension": "dim(b_i)/dim(x_j)"
        },
        {
          "symbol": "b_i",
          "meaning": "constraint bound",
          "unit": "constraint-specific",
          "dimension": "constraint-specific"
        }
      ],
      "assumptions": [
        "Linear objective and constraints",
        "Feasible polyhedron",
        "No integer restrictions unless explicitly added"
      ],
      "conditions": [
        "Each row i must combine terms with matching units"
      ],
      "sources": [
        "S01"
      ]
    },
    {
      "id": "RWEA-003",
      "domain": "optimization",
      "equation": "minimize 1/2 x^T Q x + c^T x subject to linear constraints",
      "variables": [
        {
          "symbol": "x",
          "meaning": "decision vector",
          "unit": "application-defined",
          "dimension": "application-defined"
        },
        {
          "symbol": "Q_ij",
          "meaning": "quadratic cost coefficient",
          "unit": "objective-unit/(x_i*x_j)",
          "dimension": "objective/(dim(x_i)*dim(x_j))"
        },
        {
          "symbol": "c_i",
          "meaning": "linear cost coefficient",
          "unit": "objective-unit/x_i",
          "dimension": "objective/dim(x_i)"
        }
      ],
      "assumptions": [
        "Quadratic objective",
        "For convex global optimization, Q is positive semidefinite",
        "Linear constraints in stated form"
      ],
      "conditions": [
        "Coefficient units depend on each variable's unit"
      ],
      "sources": [
        "S01",
        "S02"
      ]
    },
    {
      "id": "RWEA-004",
      "domain": "estimation",
      "equation": "minimize ||A x - b||_2^2",
      "variables": [
        {
          "symbol": "A_ij",
          "meaning": "design/measurement coefficient",
          "unit": "b_i/x_j",
          "dimension": "dim(b_i)/dim(x_j)"
        },
        {
          "symbol": "x_j",
          "meaning": "unknown parameter",
          "unit": "parameter-specific",
          "dimension": "parameter-specific"
        },
        {
          "symbol": "b_i",
          "meaning": "observation",
          "unit": "observation-specific",
          "dimension": "observation-specific"
        },
        {
          "symbol": "r_i",
          "meaning": "residual",
          "unit": "same as b_i",
          "dimension": "dim(b_i)"
        }
      ],
      "assumptions": [
        "Least-squares loss is appropriate",
        "Rank/conditioning and noise model are checked",
        "Residuals within each summed norm share compatible units"
      ],
      "conditions": [
        "Whiten or scale heterogeneous observations before combining residuals"
      ],
      "sources": [
        "S01",
        "S05"
      ]
    },
    {
      "id": "RWEA-005",
      "domain": "estimation",
      "equation": "minimize ||A x-b||_2^2 + lambda ||x||_2^2",
      "variables": [
        {
          "symbol": "lambda",
          "meaning": "ridge penalty coefficient",
          "unit": "residual-unit^2/parameter-unit^2",
          "dimension": "dim(b)^2/dim(x)^2"
        },
        {
          "symbol": "x",
          "meaning": "parameter vector",
          "unit": "parameter-specific",
          "dimension": "parameter-specific"
        }
      ],
      "assumptions": [
        "Quadratic penalty",
        "Feature/parameter scaling is declared",
        "lambda chosen by validation or justified prior"
      ],
      "conditions": [
        "If parameters have different units, scale or use a dimensionally weighted penalty"
      ],
      "sources": [
        "S01",
        "S02"
      ]
    },
    {
      "id": "RWEA-006",
      "domain": "estimation",
      "equation": "minimize ||A x-b||_2^2 + lambda ||x||_1",
      "variables": [
        {
          "symbol": "lambda",
          "meaning": "sparsity penalty coefficient",
          "unit": "residual-unit^2/parameter-unit",
          "dimension": "dim(b)^2/dim(x)"
        },
        {
          "symbol": "x",
          "meaning": "parameter vector",
          "unit": "parameter-specific",
          "dimension": "parameter-specific"
        }
      ],
      "assumptions": [
        "Sparse solution is meaningful",
        "Parameters are scaled consistently",
        "Penalty strength selected by validation"
      ],
      "conditions": [
        "Unit-aware scaling is necessary when parameter units differ"
      ],
      "sources": [
        "S01",
        "S02"
      ]
    },
    {
      "id": "RWEA-007",
      "domain": "inference",
      "equation": "p(theta|D)=p(D|theta)p(theta)/p(D)",
      "variables": [
        {
          "symbol": "theta",
          "meaning": "unknown parameter/state",
          "unit": "model-specific",
          "dimension": "model-specific"
        },
        {
          "symbol": "D",
          "meaning": "observed data",
          "unit": "data-specific",
          "dimension": "data-specific"
        },
        {
          "symbol": "p",
          "meaning": "probability or probability density",
          "unit": "dimensionless for discrete probabilities; inverse parameter units for densities",
          "dimension": "density dimension depends on measure"
        }
      ],
      "assumptions": [
        "Prior and likelihood are proper or otherwise mathematically well-defined",
        "Data-generating model is adequate",
        "Measure and density conventions are explicit"
      ],
      "conditions": [
        "Do not treat continuous densities as dimensionless scalars"
      ],
      "sources": [
        "S05",
        "S06"
      ]
    },
    {
