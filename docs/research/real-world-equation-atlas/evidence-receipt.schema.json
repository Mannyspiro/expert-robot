{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin Evidence Receipt",
  "type": "object",
  "required": [
    "receipt_schema",
    "created_at_utc",
    "claim_scope",
    "git_commit",
    "git_ref",
    "command",
    "runtime",
    "source_sha256",
    "artifact",
    "verification_boundary"
  ],
  "properties": {
    "receipt_schema": {
      "const": "merlin-evidence-receipt/0.1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "git_ref": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "verification_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
