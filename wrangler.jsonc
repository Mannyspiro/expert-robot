{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expert-robot-observer",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "triggers": {"crons": ["23 16 * * *"]},
  "durable_objects": {"bindings": [{"name": "RESEARCH_LEDGER", "class_name": "ResearchLedger"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ResearchLedger"]}]
}
