{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merlin.invalid/schemas/heldout-task-record-v1.json",
  "title": "Merlin Held-Out Benchmark Task Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "benchmark_version",
    "domain",
    "family",
    "difficulty",
    "split",
    "prompt_sha256",
    "allowed_capabilities",
    "forbidden_capabilities",
    "resource_budget",
    "expected_outputs",
    "evaluator",
    "scoring_rubric",
    "critical_failure_conditions",
    "provenance"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "benchmark_version": { "const": "1.0.0" },
    "domain": { "enum": ["mathematics", "lean", "research", "coding", "engineering"] },
    "family": { "type": "string", "minLength": 2, "maxLength": 80 },
    "difficulty": { "enum": ["introductory", "intermediate", "advanced", "expert"] },
    "split": { "enum": ["train", "validation", "holdout"] },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "prompt_artifact_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "allowed_capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "forbidden_capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "max_tool_calls"],
      "properties": {
        "wall_time_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "max_memory_mb": { "type": "integer", "minimum": 64 },
        "max_cpu_seconds": { "type": "integer", "minimum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "required"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "required": { "type": "boolean" },
          "schema_ref": { "type": "string" }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "version", "sha256", "mode"],
      "properties": {
        "evaluator_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "enum": ["deterministic", "rubric", "hybrid"] },
        "toolchain": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "scoring_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "evidence", "completeness", "constraint_compliance"],
      "properties": {
        "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "constraint_compliance": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "critical_failure_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "source", "manifest_revision"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "manifest_revision": { "type": "string", "minLength": 1, "maxLength": 100 },
        "review_receipt_ref": { "type": "string", "maxLength": 512 }
      }
    },
    "seed": { "type": "integer" },
    "reference_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "adjudication_notes": { "type": "string", "maxLength": 4000 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
